# Supabase: Project Settings -> Data API -> Project URL / anon public key.
# Copy this file to .env.local and fill both in. .env.local is never committed.
# NEVER put the service_role key here: anything prefixed VITE_ is shipped to
# every visitor.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-public-key>"
